rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. Entity Validation Blueprints
    function isValidChallenge(data) {
      return data.keys().hasAll([
        'ownerId', 'title', 'subtitle', 'category', 'startDate',
        'targetDays', 'habits', 'completedDays', 'reminderEnabled',
        'reminderTime', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'title', 'subtitle', 'category', 'startDate',
        'targetDays', 'habits', 'completedDays', 'reminderEnabled',
        'reminderTime', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
      data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 240 &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
      data.category in ['Mindfulness', 'Fitness', 'Deep Work', 'Nutrition', 'Reading', 'Custom'] &&
      data.startDate is string && data.startDate.size() == 10 && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.targetDays is int && data.targetDays == 30 &&
      data.habits is list && data.habits.size() >= 1 && data.habits.size() <= 8 &&
      data.habits[0] is string && data.habits[0].size() >= 1 && data.habits[0].size() <= 160 &&
      data.completedDays is list && data.completedDays.size() <= 30 &&
      (data.completedDays.size() == 0 || (data.completedDays[0] is int && data.completedDays[0] >= 1 && data.completedDays[0] <= 30)) &&
      data.reminderEnabled is bool &&
      data.reminderTime is string && data.reminderTime.size() == 5 && data.reminderTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
      data.status is string && data.status.size() >= 1 && data.status.size() <= 20 &&
      data.status in ['active', 'completed', 'archived'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidHabitLog(data, challengeId) {
      return data.keys().hasAll([
        'ownerId', 'challengeId', 'dayNumber', 'dateStr',
        'completedHabitIds', 'reflectionNote', 'moodScore',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'challengeId', 'dayNumber', 'dateStr',
        'completedHabitIds', 'reflectionNote', 'moodScore',
        'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.challengeId is string && data.challengeId.size() >= 1 && data.challengeId.size() <= 128 && data.challengeId == challengeId &&
      data.dayNumber is int && data.dayNumber >= 1 && data.dayNumber <= 30 &&
      data.dateStr is string && data.dateStr.size() == 10 && data.dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.completedHabitIds is list && data.completedHabitIds.size() <= 8 &&
      (data.completedHabitIds.size() == 0 || (data.completedHabitIds[0] is string && data.completedHabitIds[0].size() >= 1 && data.completedHabitIds[0].size() <= 64)) &&
      data.reflectionNote is string && data.reflectionNote.size() <= 500 &&
      data.moodScore is int && data.moodScore >= 1 && data.moodScore <= 5 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidNotificationPreference(data, userId) {
      return data.keys().hasAll([
        'ownerId', 'pushEnabled', 'morningQuoteTime', 'eveningCheckinTime',
        'quoteTheme', 'soundEnabled', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'pushEnabled', 'morningQuoteTime', 'eveningCheckinTime',
        'quoteTheme', 'soundEnabled', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid && data.ownerId == userId &&
      data.pushEnabled is bool &&
      data.morningQuoteTime is string && data.morningQuoteTime.size() == 5 && data.morningQuoteTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
      data.eveningCheckinTime is string && data.eveningCheckinTime.size() == 5 && data.eveningCheckinTime.matches('^[0-2][0-9]:[0-5][0-9]$') &&
      data.quoteTheme is string && data.quoteTheme.size() >= 1 && data.quoteTheme.size() <= 40 &&
      data.quoteTheme in ['Stoic Discipline', 'Atomic Systems', 'Mindful Presence', 'Peak Endurance'] &&
      data.soundEnabled is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 4. Collection Rules: Challenges
    match /challenges/{challengeId} {
      allow get: if isSignedIn() && isValidId(challengeId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(challengeId) &&
        isValidChallenge(incoming()) &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(challengeId) &&
        isValidChallenge(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status != 'completed' && (
          // Action 1: Log progress / toggle completed days or status
          incoming().diff(existing()).affectedKeys().hasOnly(['completedDays', 'status', 'updatedAt']) ||
          // Action 2: Update challenge metadata, habits, or reminder schedule
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subtitle', 'category', 'habits', 'reminderEnabled', 'reminderTime', 'status', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isValidId(challengeId) && existing().ownerId == request.auth.uid;

      // 5. Subcollection Rules: Daily Habit Logs (Master Gate Pattern)
      match /logs/{logId} {
        allow get: if isSignedIn() &&
          isValidId(challengeId) &&
          isValidId(logId) &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/challenges/$(challengeId)).data.ownerId == request.auth.uid;

        allow list: if isSignedIn() &&
          resource.data.ownerId == request.auth.uid;

        allow create: if isSignedIn() &&
          isValidId(challengeId) &&
          isValidId(logId) &&
          isValidHabitLog(incoming(), challengeId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/challenges/$(challengeId)) &&
          get(/databases/$(database)/documents/challenges/$(challengeId)).data.ownerId == request.auth.uid;

        allow update: if isSignedIn() &&
          isValidId(challengeId) &&
          isValidId(logId) &&
          isValidHabitLog(incoming(), challengeId) &&
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().challengeId == existing().challengeId &&
          incoming().dayNumber == existing().dayNumber &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['completedHabitIds', 'reflectionNote', 'moodScore', 'dateStr', 'updatedAt']) &&
          get(/databases/$(database)/documents/challenges/$(challengeId)).data.ownerId == request.auth.uid;

        allow delete: if isSignedIn() &&
          isValidId(challengeId) &&
          isValidId(logId) &&
          existing().ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/challenges/$(challengeId)).data.ownerId == request.auth.uid;
      }
    }

    // 6. Collection Rules: Notification Preferences
    match /notificationPreferences/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && existing().ownerId == request.auth.uid;
      allow list: if false;

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidNotificationPreference(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidNotificationPreference(incoming(), userId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'pushEnabled', 'morningQuoteTime', 'eveningCheckinTime',
          'quoteTheme', 'soundEnabled', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && existing().ownerId == request.auth.uid;
    }
  }
}
